{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CDeck",
  "version": "0.1.0",
  "identifier": "dev.cdeck.app",
"build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CDeck",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing --enable-software-rasterizer --disable-gpu-sandbox"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
